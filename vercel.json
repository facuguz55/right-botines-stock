{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/crm",
      "destination": "/crm.html"
    },
    {
      "source": "/crm/(.*)",
      "destination": "/crm.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-resync",
      "schedule": "0 11 * * *"
    }
  ]
}
